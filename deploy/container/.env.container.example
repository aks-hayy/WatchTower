# Tracked template. Copy to deploy/container/.env.container; the copy is ignored.
# scripts/container.ps1 init or scripts/container.sh init creates the master key.
WATCHTOWER_MASTER_KEY_FILE=deploy/container/secrets/watchtower_master_key
WATCHTOWER_UI_PORT=4173
WATCHTOWER_HYBRID_BRIDGE=0

# Needed only with deploy/compose.mesh.yaml. Use a VPN-overlay address for
# remote sensors; do not expose the mesh listener on an unprotected public IP.
# WATCHTOWER_MESH_BIND_ADDRESS=100.64.0.10

# Needed only with deploy/compose.neo4j.yaml.
# WATCHTOWER_NEO4J_PASSWORD_FILE=deploy/container/secrets/watchtower_neo4j_password

# Needed only with the linux-sensor profile.
# WATCHTOWER_SENSOR_INTERFACE=eth0
# WATCHTOWER_SENSOR_AGENT=1
