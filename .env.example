# Optional runtime location overrides. Leave unset for platform defaults.
# WATCHTOWER_HOME=C:\WatchTower-Runtime
# WATCHTOWER_DATA_DIR=C:\WatchTower-Data

# Required only while starting the optional Neo4j container.
# Do not commit a real value.
# WATCHTOWER_NEO4J_PASSWORD=replace-in-your-shell-only

# AI provider secrets are intentionally not configured here.
# Use: tower ai provider connect openai
# Windows stores the resulting secret in Credential Manager.
