# Watchtower Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── VirusTotal (optional) ────────────────────────────────────────────────────
# Enables malware hash lookups during PCAP file carving.
# Free key: https://www.virustotal.com/gui/join-us
VT_API_KEY=your_virustotal_api_key_here

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Choose "openai" or "ollama"
WATCHTOWER_AI_PROVIDER=openai

# OpenAI (if WATCHTOWER_AI_PROVIDER=openai)
# Get a key: https://platform.openai.com/api-keys
WATCHTOWER_AI_KEY=your_openai_api_key_here
WATCHTOWER_OPENAI_MODEL=gpt-4o-mini

# Ollama (if WATCHTOWER_AI_PROVIDER=ollama) — runs fully offline, no API key needed
# Install Ollama: https://ollama.ai
# Then run: ollama pull llama3
WATCHTOWER_OLLAMA_HOST=http://localhost:11434
WATCHTOWER_OLLAMA_MODEL=llama3

# ─── SIEM Integration (optional) ─────────────────────────────────────────────
# Export alerts to a remote SIEM via syslog (UDP)
# WATCHTOWER_SIEM_HOST=192.168.1.200
# WATCHTOWER_SIEM_PORT=514
